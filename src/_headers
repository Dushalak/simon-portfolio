# Content-hashed resources can be reused without a network round trip.
/assets/optimized/*
  Cache-Control: public, max-age=31536000, immutable

/effects/*
  Cache-Control: public, max-age=31536000, immutable

/assets/projects-lite.*.json
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
